# ── LLM ─────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
LLM_PROVIDER=gemini           # gemini | ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# ── Broker ───────────────────────────────────────────────────────────────────
BROKER_MODE=paper             # paper | live
KITE_API_KEY=your_kite_api_key_here
KITE_SECRET=your_kite_secret_here
KITE_ACCESS_TOKEN=            # refreshed daily via scripts/setup_kite.py

UPSTOX_API_KEY=
UPSTOX_SECRET=

# ── News / Data APIs ─────────────────────────────────────────────────────────
TAVILY_API_KEY=
GNEWS_API_KEY=

# ── Infrastructure ───────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/stockagent

# ── App ──────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
